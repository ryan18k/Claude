{
  "expo": {
    "name": "Swiss Halal",
    "slug": "swiss-halal",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "swisshalal",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Swiss Halal utilise votre position uniquement pour afficher les restaurants proches de vous. Elle n’est ni enregistrée ni partagée.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "supportsRTL": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
