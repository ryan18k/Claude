{
  "name": "swiss-halal",
  "private": true,
  "description": "Swiss Halal \u2014 annuaire v\u00e9rifi\u00e9 des restaurants halal de Suisse romande (monorepo)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev:mobile": "pnpm --filter @swisshalal/mobile start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/supabase/src/database.types.ts",
    "web:mobile": "pnpm --filter @swisshalal/mobile web",
    "ios:device": "pnpm --filter @swisshalal/mobile ios:device",
    "ios:simulator": "pnpm --filter @swisshalal/mobile ios:simulator",
    "ios:rebuild": "pnpm --filter @swisshalal/mobile ios:rebuild",
    "build:ios:dev": "pnpm --filter @swisshalal/mobile build:ios:dev",
    "eas": "pnpm --filter @swisshalal/mobile eas"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
