# =============================================================================
# Fichier d'EXEMPLE. Copie-le en ".env" (ou "apps/mobile/.env") et remplis-le.
# Le vrai fichier .env est ignoré par git : il ne doit JAMAIS être commité.
# =============================================================================

# --- Supabase (valeurs PUBLIQUES, utilisables dans l'app) --------------------
# URL du projet. En local : affichée par `pnpm db:start` (http://127.0.0.1:54321).
EXPO_PUBLIC_SUPABASE_URL=
# Clé "anon" / "publishable" : publique par conception, la sécurité repose sur la RLS.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Carte --------------------------------------------------------------------
# Style de carte vectorielle swisstopo (gratuit, attribution obligatoire).
EXPO_PUBLIC_MAP_STYLE_URL=https://vectortiles.geo.admin.ch/styles/ch.swisstopo.lightbasemap.vt/style.json

# --- SECRETS (serveur uniquement : Edge Functions / CI) ------------------------
# Ne JAMAIS préfixer par EXPO_PUBLIC_ : ces valeurs ne doivent pas finir dans l'app.
# Elles se configurent avec `supabase secrets set` pour les Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ZEFIX_API_USER=
ZEFIX_API_PASSWORD=
SMTP_PASSWORD=
